{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hb-image-challenge",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "OWNER_ID": ""
  },
  "ai": { "binding": "AI" },
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "hb-image-challenge-images" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hb-image-challenge",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
